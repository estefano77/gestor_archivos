# Conexión a MongoDB (MongoDB Atlas recomendado para Vercel)
# Ejemplo: mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/gestor_archivos?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gestor_archivos

# Secreto para firmar tokens de sesión JWT (mínimo 32 caracteres).
#
# IMPORTANTE: no copies el valor de este archivo a tu .env.local. Este repositorio
# es público, así que cualquier valor que pongas aquí queda comprometido y
# permitiría a un tercero falsificar sesiones y acceder a los archivos de
# cualquier usuario. Genera uno propio con:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=pega_aqui_un_secreto_aleatorio_de_32_caracteres_o_mas

# Nombre público de la aplicación
NEXT_PUBLIC_APP_NAME="CloudVault - Gestor de Archivos"

# Credenciales de Google para iniciar sesión con una cuenta de Google.
# Google Cloud Console > APIs y Servicios > Credenciales > Crear credenciales >
# ID de cliente OAuth > Aplicación web.
#
# En "URI de redirección autorizado" registra exactamente estas dos:
#   http://localhost:3000/api/auth/google/callback
#   https://<tu-dominio>.vercel.app/api/auth/google/callback
#
# El Client Secret se usa solo en el servidor. Sin estas dos variables, el
# botón de Google no aparece y el resto de la aplicación funciona igual.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# Pone a "true" para que aparezca el botón de Google en la pantalla de acceso.
# Esta bandera sí llega al navegador (por eso es NEXT_PUBLIC_), pero no contiene
# ningún secreto: solo decide si se pinta el botón. El Client Secret se usa
# exclusivamente en el servidor.
NEXT_PUBLIC_GOOGLE_ENABLED=false
